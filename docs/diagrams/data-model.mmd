erDiagram
    users ||--o{ sessions : has
    users ||--o{ workspace_members : joins
    workspaces ||--o{ workspace_members : has
    workspaces ||--o{ channels : contains
    channels ||--o{ channel_members : has
    users ||--o{ channel_members : is
    channels ||--o{ messages : contains
    messages ||--o{ messages : "thread replies"
    messages ||--o{ reactions : has
    messages ||--o{ attachments : has
    users {
        int id PK
        text username UK
        text display_name
        text password_hash
    }
    sessions {
        text token_hash PK
        int user_id FK
        int expires_at
    }
    workspaces {
        int id PK
        text name
        text invite_code UK
        int owner_id FK
    }
    channels {
        int id PK
        int workspace_id FK
        text name
        text topic
        bool is_private
        bool is_dm
    }
    channel_members {
        int channel_id FK
        int user_id FK
        int last_read_id
    }
    messages {
        int id PK
        int channel_id FK
        int user_id FK
        int parent_id FK
        text body
        int edited_at
        bool deleted
    }
    reactions {
        int message_id FK
        int user_id FK
        text emoji
    }
    attachments {
        int id PK
        int message_id FK
        text filename
        text content_type
        text storage_name UK
    }
